{
  "name": "@zesun33/mcp-formal",
  "version": "0.1.1",
  "description": "Model Context Protocol (MCP) server for SymbiYosys formal verification (BMC/prove) and SVA linting",
  "type": "module",
  "bin": {
    "mcp-formal": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/parsers.test.ts tests/contract.test.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zesun33/mcp-formal.git"
  },
  "engines": {
    "node": ">=18"
  }
}
